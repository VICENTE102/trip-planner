{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "nodenext",
    /* Node 24 ejecuta TypeScript quitando los tipos, pero no reescribe los
       especificadores: un import de "./x.js" no encuentra x.ts. Los scripts
       importan con extensión .ts real, que es lo que Node sí resuelve. El
       backend no puede hacer esto (Vercel compila de verdad), de ahí que
       scripts/ tenga su propio proyecto en vez de entrar en tsconfig.server. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
